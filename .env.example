# ── Required ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=            # Claude API — outreach + narrative generation
JWT_SECRET_KEY=               # min 32 chars — signs access tokens

# ── Email delivery (optional — outreach preview works without it) ───────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=            # verified sender address
PHYSICAL_ADDRESS=             # CAN-SPAM §7(a)(5)(A) mailing address

# ── Storage (defaults shown) ─────────────────────────────────────────────────
DATABASE_URL=./data/gtmlens.duckdb
SQLITE_PATH=./data/logs.db
MODELS_DIR=./data/models

# ── Statistical tuning (defaults shown) ──────────────────────────────────────
CATE_UPLIFT_THRESHOLD=0.40        # top fraction of segments that get outreach
HOLDOUT_FRACTION=0.20             # fraction of each segment held out for lift
COLD_START_CONTROL_FRACTION=0.50  # wave-0 randomization split for /api/score
SCORE_DEPRIORITIZE_FRACTION=0.30  # bottom CATE fraction tiered "deprioritize"
CUPED_VARIANCE_REDUCTION_TARGET=0.30
WINSORIZE_UPPER_PCT=0.99
LOG_OFFSET=1.0

# ── Auth / demo data (defaults shown) ────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
N_USERS=50000                     # synthetic demo dataset size
SEED=42                           # synthetic data RNG seed
